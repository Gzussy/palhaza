---
import Layout from '../layouts/Layout.astro';

const vendeglatok = [
	{
		nev: "Hegyközi Ízek Étterme",
		kategoria: "Hagyományos Konyha",
		leiras: "A régió vadételei, sztrapacska és kemencés finomságok helyi alapanyagokból elkészítve.",
		cim: "Pálháza, Dózsa Gy. út 15.",
		ikon: "🍲"
	},
	{
		nev: "Erdei Kisvasút Büfé & Kávézó",
		kategoria: "Kávézó & Cukrászda",
		leiras: "Kézműves sütemények, friss kávékülönlegességek és hűsítő frissítők a kisvasút végállomásánál.",
		cim: "Pálháza, Állomás tér 2.",
		ikon: "☕"
	},
	{
		nev: "Zempléni Pincészet & Kóstolóház",
		kategoria: "Borkóstoló",
		leiras: "Helyi és környékbeli tokaji, valamint zempléni borok kóstolója autentikus pincerendszerben.",
		cim: "Pálháza, Pincesor 8.",
		ikon: "🍷"
	}
];
---

<Layout title="Gasztro - Pálháza Város" activePage="gasztro">
	<div class="fixed inset-0 w-full h-full -z-10 overflow-hidden">
		<img src="/media/back.jpg" alt="Pálháza háttér" class="w-full h-full object-cover filter brightness-50" />
	</div>

	<main class="max-w-7xl mx-auto px-6 py-12 relative z-10">
		<div class="mb-12 text-center md:text-left">
			<span class="inline-block bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-4 py-1.5 rounded-full text-xs font-semibold mb-4 backdrop-blur-sm">
				Helyi Ízek & Vendéglátás
			</span>
			<h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4">
				Gasztronómia Pálházán
			</h1>
			<p class="text-slate-300 max-w-2xl text-base md:text-lg">
				Kóstolja meg a Zemplén vadételeit, a hegyközi házias ízeket és a vidék kiváló borait.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{vendeglatok.map((hely) => (
				<div class="bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/15 hover:border-emerald-400/50 transition-all duration-300 shadow-xl flex flex-col justify-between group">
					<div>
						<div class="w-14 h-14 bg-emerald-500/20 text-emerald-300 rounded-2xl flex items-center justify-center text-3xl mb-6 border border-emerald-500/30">
							{hely.ikon}
						</div>
						<span class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2 block">{hely.kategoria}</span>
						<h2 class="text-2xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">{hely.nev}</h2>
						<p class="text-slate-300 text-sm leading-relaxed mb-6">{hely.leiras}</p>
					</div>

					<div class="pt-4 border-t border-white/10 text-xs text-slate-400 flex items-center gap-2">
						<span>📍</span>
						<span>{hely.cim}</span>
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>