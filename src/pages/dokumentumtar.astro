---
import Layout from '../layouts/Layout.astro';

const kategoriak = [
	{
		cim: "Polgármesteri Hivatal",
		ikon: "🏛️",
		leiras: "Önkormányzati rendeletek, testületi jegyzőkönyvek és határozatok.",
		dokumentumok: [
			{ nev: "2026. évi Költségvetési Rendelet (PDF)", datum: "2026.02.15", meret: "2.4 MB" },
			{ nev: "Képviselő-testületi Jegyzőkönyv - 2026. Január (PDF)", datum: "2026.01.28", meret: "1.1 MB" },
			{ nev: "Helyi Adó Rendelet Módosítás (PDF)", datum: "2025.12.10", meret: "850 KB" }
		]
	},
	{
		cim: "Napközi Otthonos Óvoda és Bölcsőde",
		ikon: "🧸",
		leiras: "Beiratkozási hirdetmények, házirend és intézményi dokumentumok.",
		dokumentumok: [
			{ nev: "Óvodai Beiratkozási Hirdetmény 2026/2027 (PDF)", datum: "2026.03.01", meret: "620 KB" },
			{ nev: "Intézményi Házirend és Szervezeti Szabályzat (PDF)", datum: "2025.09.01", meret: "1.8 MB" }
		]
	},
	{
		cim: "Alapszolgáltatási Központ",
		ikon: "🤝",
		leiras: "Szociális ellátással és gyermekjóléti szolgáltatásokkal kapcsolatos nyomtatványok.",
		dokumentumok: [
			{ nev: "Szociális Étkeztetés Igénylőlap (PDF)", datum: "2026.01.10", meret: "450 KB" },
			{ nev: "Házi Segítségnyújtás Tájékoztató (PDF)", datum: "2025.11.15", meret: "780 KB" }
		]
	},
	{
		cim: "Pálházi Szlovák Nemzetiségi Önkormányzat",
		ikon: "🌍",
		leiras: "Nemzetiségi önkormányzati határozatok és kulturális beszámolók.",
		dokumentumok: [
			{ nev: "Nemzetiségi Önkormányzat Munkaterve 2026 (PDF)", datum: "2026.01.15", meret: "520 KB" },
			{ nev: "Pénzügyi Beszámoló 2025 (PDF)", datum: "2026.02.01", meret: "1.3 MB" }
		]
	}
];
---

<Layout title="Dokumentumtár - Pálháza Város" activePage="dokumentumtar">

	<main class="max-w-7xl mx-auto px-6 py-12 relative z-10">
		<div class="mb-12 text-center md:text-left">
			<span class="inline-block bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-4 py-1.5 rounded-full text-xs font-semibold mb-4 backdrop-blur-sm">
				Közzétételi Tár & Digitális Archívum
			</span>
			<h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4">
				Hivatalos Dokumentumtár
			</h1>
			<p class="text-slate-300 max-w-2xl text-base md:text-lg">
				Pálháza Város Önkormányzata és intézményeinek nyilvános szabályzatait, határozatait és letölthető nyomtatványait gyűjtöttük össze egy helyen.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-8 mb-12">
			{kategoriak.map((kat) => (
				<div class="bg-white/10 backdrop-blur-md p-6 md:p-8 rounded-2xl border border-white/15 shadow-xl transition-all duration-300 hover:border-emerald-400/40">
					<div class="flex items-center gap-4 mb-4">
						<div class="w-12 h-12 bg-emerald-500/20 text-emerald-300 rounded-xl flex items-center justify-center font-bold text-2xl border border-emerald-500/30">
							{kat.ikon}
						</div>
						<div>
							<h2 class="text-2xl font-bold text-white">{kat.cim}</h2>
							<p class="text-slate-300 text-sm">{kat.leiras}</p>
						</div>
					</div>

					<div class="mt-6 divide-y divide-white/10 border-t border-white/10">
						{kat.dokumentumok.map((doc) => (
							<div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover:bg-white/5 px-3 rounded-xl transition-colors">
								<div class="flex items-center gap-3">
									<span class="text-emerald-400 font-bold">📄</span>
									<div>
										<h3 class="text-white font-medium group-hover:text-emerald-300 transition-colors text-sm md:text-base">
											{doc.nev}
										</h3>
										<p class="text-xs text-slate-400">Feltöltve: {doc.datum} • Méret: {doc.meret}</p>
									</div>
								</div>
								<a 
									href="#" 
									class="inline-flex items-center justify-center gap-2 bg-emerald-600/80 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2 rounded-lg backdrop-blur-md border border-emerald-400/30 transition-all duration-300 hover:scale-105 shadow-md whitespace-nowrap self-start sm:self-auto">
									<span>Letöltés</span>
									<span>⬇️</span>
								</a>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</main>
</Layout>