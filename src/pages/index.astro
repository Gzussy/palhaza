---
import Layout from '../layouts/Layout.astro';

const turistagombok = [
    { cim: "Látványosságok", ikon: "🏰", link: "/latvanyossagok" },
    { cim: "Túraútvonalak", ikon: "🥾", link: "/turautvonalak" },
    { cim: "Gasztro", ikon: "🍽️", link: "/gasztro" },
    { cim: "Események", ikon: "📅", link: "/esemenyek" },
    { cim: "Szállások", ikon: "🛏️", link: "/szallasok" },
    { cim: "Városunkról", ikon: "🌲", link: "/varosunkrol" },
];
---

<Layout title="Pálháza Város Hivatalos Portálja" activePage="kezdolap">
    <!-- HÁTTÉRVIDEÓ -->
    <div class="fixed inset-0 w-full h-full -z-20 overflow-hidden">
        <video 
            id="bg-video"
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto"
            class="absolute min-w-full min-h-full w-auto h-auto top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 object-cover filter brightness-50">
            <source src="/media/videoplayback.mp4" type="video/mp4" />
        </video>
    </div>

    <div id="main-content">
        <!-- HERO SZEKCIÓ -->
        <section class="py-16 md:py-24 px-4 text-center relative z-10">
            <div class="max-w-5xl mx-auto">
                <span class="inline-block bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-4 py-1.5 rounded-full text-xs md:text-sm font-medium mb-6 backdrop-blur-sm shadow-sm animate-slide-down">
                    Zemplén legkisebb városa, a természet ölelésében
                </span>
                <h1 class="text-3xl sm:text-5xl md:text-6xl font-black mb-6 tracking-tight drop-shadow-md leading-tight animate-slide-down" style="animation-delay: 0.1s;">
                    Üdvözöljük Pálháza Hivatalos Portálján
                </h1>
                <p class="text-base sm:text-lg md:text-xl text-slate-200 mb-10 max-w-2xl mx-auto leading-relaxed animate-slide-down" style="animation-delay: 0.2s;">
                    Fedezze fel a Hegyköz központját: turisztikai látnivalók, túraútvonalak, helyi ízek, rendezvények és önkormányzati információk egy helyen.
                </p>
                
                <!-- A 6 ELEMES GOMBCSOPORT: KÉT OLDALRÓL BEÚSZVA -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 md:gap-4 max-w-4xl mx-auto">
                    {turistagombok.map((gomb, index) => {
                        const animClass = index % 2 === 0 ? "animate-slide-left" : "animate-slide-right";
                        const delay = 0.3 + index * 0.1;
                        return (
                            <a 
                                href={gomb.link} 
                                style={`animation-delay: ${delay}s;`}
                                class={`group bg-white/10 hover:bg-emerald-900/40 text-white font-bold px-4 py-3.5 md:py-4 rounded-2xl shadow-lg backdrop-blur-md border border-white/20 hover:border-emerald-400/50 hover:-translate-y-1 active:translate-y-0 transition-all duration-300 flex items-center justify-between text-sm md:text-base ${animClass}`}>
                                <span class="flex items-center gap-2">
                                    <span class="text-lg md:text-xl group-hover:scale-125 transition-transform duration-300">{gomb.ikon}</span>
                                    <span>{gomb.cim}</span>
                                </span>
                                <span class="text-emerald-400 group-hover:translate-x-1 transition-transform duration-300">&rarr;</span>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- GYORS ELÉRHETŐSÉGEK / FŐ KÁRTYÁK: LENTRŐL FELFELÉ BEÚSZVA -->
        <main class="max-w-7xl mx-auto px-6 py-8 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- 1. KÁRTYA -->
                <a href="/onkormanyzat" style="animation-delay: 0.8s;" class="animate-slide-up group relative bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/15 hover:bg-emerald-900/30 hover:border-emerald-400/60 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-900/50 transition-all duration-300 flex flex-col justify-between">
                  <div>
                    <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6 border border-emerald-500/30 group-hover:scale-110 group-hover:bg-emerald-500/30 transition duration-300">
                        🏛️
                    </div>
                    <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-300 transition-colors">Önkormányzat & Hivatal</h3>
                    <p class="text-slate-300 mb-6 leading-relaxed text-sm">
                        Képviselő-testületi adatok, rendeletek, határozatok és a Polgármesteri Hivatal elérhetőségei.
                    </p>
                  </div>
                    <span class="text-emerald-400 font-semibold inline-flex items-center gap-2 group-hover:translate-x-2 transition-transform duration-300">
                        Tovább az önkormányzathoz &rarr;
                    </span>
                </a>

                <!-- 2. KÁRTYA -->
                <a href="/dokumentumtar" style="animation-delay: 0.95s;" class="animate-slide-up group relative bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/15 hover:bg-emerald-900/30 hover:border-emerald-400/60 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-900/50 transition-all duration-300 flex flex-col justify-between">
                  <div>
                    <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6 border border-emerald-500/30 group-hover:scale-110 group-hover:bg-emerald-500/30 transition duration-300">
                        📂
                    </div>
                    <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-300 transition-colors">Dokumentumtár</h3>
                    <p class="text-slate-300 mb-6 leading-relaxed text-sm">
                        Több-intézményi közzétételi tár: Hivatal, Óvoda-Bölcsőde, Szociális Központ és Szlovák Nemzetiségi Önkormányzat.
                    </p>
                  </div>
                    <span class="text-emerald-400 font-semibold inline-flex items-center gap-2 group-hover:translate-x-2 transition-transform duration-300">
                        Dokumentumok megtekintése &rarr;
                    </span>
                </a>

                <!-- 3. KÁRTYA -->
                <a href="/rendelo" style="animation-delay: 1.1s;" class="animate-slide-up group relative bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/15 hover:bg-emerald-900/30 hover:border-emerald-400/60 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-900/50 transition-all duration-300 flex flex-col justify-between">
                  <div>
                    <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6 border border-emerald-500/30 group-hover:scale-110 group-hover:bg-emerald-500/30 transition duration-300">
                        🏥
                    </div>
                    <h3 class="text-2xl font-bold mb-3 text-white group-hover:text-emerald-300 transition-colors">Egészségügyi Ellátás</h3>
                    <p class="text-slate-300 mb-6 leading-relaxed text-sm">
                        Háziorvosi, gyermekorvosi és fogászati rendelési idők, valamint az aktuális helyettesítési információk.
                    </p>
                  </div>
                    <span class="text-emerald-400 font-semibold inline-flex items-center gap-2 group-hover:translate-x-2 transition-transform duration-300">
                        Rendelési idők &rarr;
                    </span>
                </a>

            </div>
        </main>
    </div>

<script>
        document.addEventListener("DOMContentLoaded", () => {
            const imageBg = document.getElementById("image-bg") as HTMLElement;
            const video = document.getElementById("bg-video") as HTMLVideoElement;

            // 1. Induláskor: Videó indítás és kép elhalványítás (mint eddig)
            if (video) {
                video.muted = true;
                video.playsInline = true;

                setTimeout(() => {
                    const playPromise = video.play();

                    if (playPromise !== undefined) {
                        playPromise.then(() => {
                            if (imageBg) {
                                imageBg.style.opacity = "0";
                                setTimeout(() => {
                                    imageBg.style.display = "none";
                                }, 1000);
                            }
                        }).catch((error) => {
                            console.warn("Autoplay blokkolva:", error);
                        });
                    }
                }, 3000);
            }

            // 2. Kattintáskor: Kép visszahozása átfedéssel + elemek kifelé csúszása
            const links = document.querySelectorAll('a[href^="/"]');

            links.forEach(link => {
                link.addEventListener("click", (e) => {
                    const targetUrl = link.getAttribute("href");

                    if (!targetUrl || targetUrl === "#") return;

                    e.preventDefault();

                    const mainContent = document.getElementById("main-content");
                    const header = document.querySelector("header");
                    const footer = document.querySelector("footer");

                    // Először feltesszük a képet display block-ra (ha el lett volna rejtve), majd opacity 1-re húzzuk
                    if (imageBg) {
                        imageBg.style.display = "block";
                        // Pici timeout, hogy a display: block érvényre jusson az opacity átmenet előtt
                        setTimeout(() => {
                            imageBg.style.opacity = "1";
                        }, 20);
                    }

                    // Elemek kifelé csúsztatása
                    if (mainContent) mainContent.classList.add("animate-slide-up-out");
                    if (header) header.classList.add("animate-slide-up-out");
                    if (footer) footer.classList.add("animate-slide-down-out");

                    // Amikor lefut az animáció (700-800ms), átlépünk az új oldalra
                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 750);
                });
            });
        });
    </script>
</Layout>